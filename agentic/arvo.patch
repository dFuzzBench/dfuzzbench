+"""Build the T6 dataset that the ARVO env loads: one row per ARVO CVE (50 rows).
+
+The input is the T6 benchmark static/data/target-arvo/benchmark.json of this repository. Run from
+agentic/ before the first T6 run:
+
+    python data/arvo/construct.py --out-dir data/arvo/dataset   # the dataset_id of scripts/config_arvo_gemini.yaml
+    python data/arvo/construct.py                               # only print a summary of the rows
+
+--out-dir writes <dir>/test.jsonl (the split "test", one JSON object per line), which the ARVO env
+reads from that local directory (debug_gym/gym/envs/local_dataset.py). The directory is
+git-ignored; rebuild it after changing the benchmark file.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+
+DEFAULT_INPUT = Path(__file__).resolve().parents[3] / "static" / "data" / "target-arvo" / "benchmark.json"
+
+
+def build_rows(json_file_path):
+    """Reads the benchmark JSON file and returns the dataset rows, in file order."""
+    with open(json_file_path, 'r', encoding='utf-8') as f:
+        raw_data = json.load(f)
+
+    rows = []
+    for entry in raw_data:
+        # Extract target file and line number (e.g. "Libraries/LibRegex/RegexLexer.cpp:69")
+        target_info = entry.get("target_line", "")
+        if ":" in target_info:
+            target_file, target_line_str = target_info.split(":", 1)
+            target_line = int(target_line_str)
+        else:
+            target_file = target_info
+            target_line = -1
+
+        # A run reproduces the CVE when its output contains the sanitizer report and the target line.
+        pattern_list = []
+        pattern_list.append(entry.get("cve_pattern", ""))
+        pattern_list.append(target_info)
+
+        rows.append({
+            "project": entry.get("project_name", ""),
+            "target_file": target_file,
+            "target_line": target_line,
+            "url": entry.get("repo_link", ""),
+            "commit": entry.get("commit_id", ""),
+            "patch": entry.get("instrumentation_patch", ""),
+            "fuzzing_harness": entry.get("harness_code", ""),
+            "build_script": entry.get("build_script", ""),
+            "realistic_context": entry.get("realistic_context", ""),
+            "realistic_call_paths": entry.get("call_paths", []),
+            # Extra fields from JSON
+            "cve_id": entry.get("cve_id", ""),
+            "fuzz_target": entry.get("fuzz_target", ""),
+            "poc": entry.get("poc", ""),
+            "target_function": entry.get("target_function", ""),
+            "trigger_command": entry.get("trigger_command", ""),
+            "cve_pattern": pattern_list,
+        })
+
+    return rows
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--input", default=str(DEFAULT_INPUT), help="benchmark JSON (default: the T6 benchmark)")
+    parser.add_argument("--out-dir", help="write the dataset to this directory (test.jsonl, the split 'test')")
+    args = parser.parse_args()
+
+    rows = build_rows(args.input)
+    ids = [row["cve_id"] for row in rows]
+    assert len(ids) == len(set(ids)), f"duplicate CVE ids: {sorted({i for i in ids if ids.count(i) > 1})}"
+    print(f"{len(rows)} CVEs, columns: {', '.join(rows[0]) if rows else '-'}")
+
+    if args.out_dir:
+        os.makedirs(args.out_dir, exist_ok=True)
+        out_file = os.path.join(args.out_dir, "test.jsonl")
+        with open(out_file, 'w', encoding='utf-8') as f:
+            for row in rows:
+                f.write(json.dumps(row, ensure_ascii=False) + "\n")
+        print(f"Wrote {out_file}")
