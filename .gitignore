*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Run outputs, created on first use (static/.gitignore and agentic/.gitignore ignore them as well)
/static/results/
/static/exp_results/
/static/out/
exec-env-*/
exps/
